# OmniMod — local environment variables
# Copy this file to ".env" and fill in the values.

# PostgreSQL connection string.
# If you installed PostgreSQL locally with default settings:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/omnimod

# Used to sign login tokens. Set to any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# --- Optional (only if you use Stripe billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
